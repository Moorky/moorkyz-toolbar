{
  "name": "@moorkyz/toolbar",
  "version": "0.1.0",
  "description": "A lightweight, framework-agnostic, extensible toolbar for modern web applications.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "cli"
  ],
  "bin": {
    "moorkyz-toolbar": "./cli/moorkyz-toolbar.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./inspector": {
      "types": "./dist/inspector.d.ts",
      "import": "./dist/inspector.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js"
    },
    "./gesture-profile": {
      "types": "./dist/gesture-profile.d.ts",
      "import": "./dist/gesture-profile.js"
    },
    "./generator": {
      "types": "./dist/generator.d.ts",
      "import": "./dist/generator.js"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "import": "./dist/extensions.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js"
    }
  },
  "peerDependencies": {
    "@angular/core": ">=20.2.0 <21",
    "vue": ">=3.5.0 <4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@angular/platform-server": "20.3.34",
    "@types/react": "^19.0.0",
    "@vue/server-renderer": "3.5.44",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "7.8.2",
    "vue": "3.5.44"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
